# === Identity ===
# Your name — used in prompts and to tell your own writing from a
# correspondent's.
OWNER_NAME=Your Name
# IANA timezone for daily logs, briefs, and scheduling windows.
TIMEZONE=America/Los_Angeles

# === Google (managed by Composio) ===
# Required for Gmail and Google Calendar. OAuth connections are managed in
# Composio's cloud — no local token files needed.
COMPOSIO_API_KEY=your-composio-api-key

# === Account identity (no account alias lives in code) ===
# Gmail account alias -> Composio user_id, comma-separated "alias=id" pairs.
CORTEX_GMAIL_ACCOUNTS=personal=user_personal
# Calendar account aliases to fan out across. Optional — defaults to the
# aliases in CORTEX_GMAIL_ACCOUNTS above.
CORTEX_CALENDAR_ACCOUNTS=personal
# Your own email addresses, comma-separated — used to tell your own sent
# messages apart from a correspondent's reply.
CORTEX_OWNER_EMAILS=you@example.com
# Default account alias when a caller doesn't name one. Optional — defaults
# to the first alias in CORTEX_GMAIL_ACCOUNTS, else "personal".
CORTEX_PRIMARY_ACCOUNT=personal
# The inbox where important mail arrives, if different from the primary.
# Optional — defaults to CORTEX_PRIMARY_ACCOUNT.
CORTEX_BUSINESS_ACCOUNT=personal
# Project roster the heartbeat/chat prompts render, "slug=description;slug=description" (optional CORTEX_ACCOUNT_PROJECTS="alias=slug,alias=slug" maps a Gmail account to a default project). Optional — defaults to work/personal/inbox.
CORTEX_PROJECTS=work=client and business work;personal=personal;inbox=unsorted
# Per-account Composio connection ids for composio_setup.py --urls/--connect,
# "alias=gmail_conn_id:gcal_conn_id,...". Get these with --auth-configs.
# Optional — without it, --urls/--connect will report which accounts have no
# connection id configured yet, instead of guessing one.
CORTEX_COMPOSIO_CONNECTIONS=personal=ac_your_gmail_id:ac_your_calendar_id

# === Deployment host (optional — only needed if you run a second machine) ===
# SSH config alias for that host (an entry in ~/.ssh/config). Optional —
# unset means host-reachability checks are skipped with a warn.
CORTEX_VPS_SSH_ALIAS=your-host-ssh-alias
# Absolute path to this checkout on that host.
CORTEX_VPS_REPO_ROOT=/home/your-user/second-brain-core
# Non-root service user the automation runs as on that host.
CORTEX_VPS_USER=your-user

# === Single-shot LLM calls (memory flush, capture summaries) ===
# OpenRouter is the default path for calls that don't need tools — cheaper
# and faster than a full agent turn. The Agent SDK is the fallback if this
# is unset.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=moonshotai/kimi-k3

# === Claude Code (optional — a long-lived OAuth token for headless/CI runs) ===
CLAUDE_CODE_OAUTH_TOKEN=your-claude-code-oauth-token

# === Telegram (optional chat/notification channel) ===
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# === Slack (optional chat/notification channel) ===
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_CHANNEL_ID=your-channel-id
# Restrict the Slack bot to one user. Optional but recommended.
SLACK_OWNER_USER_ID=your-slack-user-id
