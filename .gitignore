.DS_Store
*.pyc
__pycache__/
.env
.env.*
!.env.example
master.env
!master.env.example
node_modules/
.venv/

# Machine-local state and databases — rebuilt on each machine, never synced.
.claude/data/state/*.json
.claude/data/memory.db
.claude/data/memory.db-*
.claude/data/chat.db
.claude/data/chat-server.pid
.claude/data/sender_reputation.db
.claude/data/sender_reputation.db-*
.claude/data/heartbeat_errors.log
.claude/data/reflect_errors.log
.claude/data/hygiene_errors.log
.claude/data/feature-timings.jsonl
.claude/data/hook-blocks.jsonl
.claude/data/sdk_stderr.log

# Vault: the template ships an empty skeleton. Notes added in your own (private)
# clone should be tracked in git so they sync between your machines and appear
# in the memory index. After cloning, populate vault/ with your own content.
